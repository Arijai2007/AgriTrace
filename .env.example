PORT=4000
HOST=127.0.0.1
LEDGER_MODE=demo
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=agritrace-demo
# On Render use HOST=0.0.0.0 and TRUST_PROXY_HOPS=1 (the Blueprint sets both).
TRUST_PROXY_HOPS=0
# The seed command and API must point to the same demo data file.
# DATA_FILE=./server/data/ledger.json
# Fabric mode requires a trusted account file. See docs/FABRIC.md.
# ACCOUNTS_FILE=./infra/identities/accounts.json
# IPFS_API=http://127.0.0.1:5001
# MQTT_URL=mqtt://127.0.0.1:1883
# ANCHOR_ADDRESS=0x...
# SEPOLIA_RPC_URL=https://...
# DEPLOYER_PRIVATE_KEY=...
