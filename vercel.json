{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agritrace-5ldg.onrender.com/api/:path*" },
    { "source": "/trace", "destination": "/index.html" },
    { "source": "/trace/:path*", "destination": "/index.html" }
  ]
}
